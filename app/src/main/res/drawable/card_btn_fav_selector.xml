<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A3B53" />
            <stroke android:width="2dp" android:color="#38BDF8" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#374151" />
            <stroke android:width="1dp" android:color="#F59E0B" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1F2430" />
            <stroke android:width="1dp" android:color="#374151" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
