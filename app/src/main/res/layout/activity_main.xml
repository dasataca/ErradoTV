<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="28dp"
    android:paddingBottom="28dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/app_icon"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="16dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="20dp"
            android:gravity="start|center_vertical">

            <!-- Fila superior: Hora y meridiano (mayor magnitud) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextClock
                    android:id="@+id/textClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextClock
                    android:id="@+id/textClockAmPm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour=" (a)"
                    android:format24Hour=""
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent" />

                <TextView
                    android:id="@+id/tvTimeZone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Fila inferior: Fecha (menor magnitud compacta) -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/btnUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:clickable="true"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/button_focus_selector">

            <ImageView
                android:id="@+id/ivUpdateIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_cloud_download"
                android:duplicateParentState="true"
                app:tint="@color/button_text_selector"
                android:contentDescription="Actualizar APK" />

            <TextView
                android:id="@+id/tvUpdateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Actualizar"
                android:textSize="16sp"
                android:duplicateParentState="true"
                android:textColor="@color/button_text_selector"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recargar"
            android:textSize="16sp"
            android:textColor="@color/button_text_selector"
            android:focusable="true"
            android:clickable="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/button_focus_selector" />
    </LinearLayout>

    <!-- Category / Country Tabs for TV -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:layout_marginBottom="16dp"
        android:focusable="false" />

    <!-- Search and Sort Bar (exclusivo para pestaña Repeticiones) -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="🔍 Buscar repetición por partido o fecha (ej: Madrid, 10/10)..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@drawable/search_box_selector"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="15sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:cursorVisible="false"
            android:nextFocusUp="@id/rvCategories"
            android:nextFocusDown="@id/rvEvents"
            android:nextFocusRight="@id/btnVoiceSearchReplay" />

        <LinearLayout
            android:id="@+id/btnVoiceSearchReplay"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:background="@drawable/voice_button_selector"
            android:nextFocusUp="@id/rvCategories"
            android:nextFocusDown="@id/rvEvents"
            android:nextFocusLeft="@id/etSearch"
            android:nextFocusRight="@id/btnSortDate">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_google_mic"
                android:duplicateParentState="true"
                android:contentDescription="Búsqueda por voz" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Voz"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/button_text_selector"
                android:duplicateParentState="true" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSortDate"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="📅 Fecha (Recientes)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/button_text_selector"
            android:background="@drawable/button_focus_selector"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/rvCategories"
            android:nextFocusDown="@id/rvEvents"
            android:nextFocusLeft="@id/btnVoiceSearchReplay"
            android:nextFocusRight="@id/btnSortName" />

        <Button
            android:id="@+id/btnSortName"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="🔤 Nombre (A-Z)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/button_text_selector"
            android:background="@drawable/button_focus_selector"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/rvCategories"
            android:nextFocusDown="@id/rvEvents"
            android:nextFocusLeft="@id/btnSortDate" />
    </LinearLayout>

    <!-- Global Search Bar (para pestaña Buscar Todo) -->
    <LinearLayout
        android:id="@+id/globalSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/etGlobalSearch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="🔍 Buscar equipo o canal en TODO GarecaTV (ej: Real Madrid, Boca, Colapinto, ESPN)..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@drawable/search_box_selector"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="15sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:cursorVisible="false"
            android:nextFocusUp="@id/rvCategories"
            android:nextFocusDown="@id/rvEvents"
            android:nextFocusRight="@id/btnVoiceGlobalSearch" />

        <LinearLayout
            android:id="@+id/btnVoiceGlobalSearch"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:background="@drawable/voice_button_selector"
            android:nextFocusUp="@id/rvCategories"
            android:nextFocusDown="@id/rvEvents"
            android:nextFocusLeft="@id/etGlobalSearch"
            android:nextFocusRight="@id/btnClearGlobalSearch">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_google_mic"
                android:duplicateParentState="true"
                android:contentDescription="Búsqueda por voz" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Voz"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/button_text_selector"
                android:duplicateParentState="true" />
        </LinearLayout>

        <Button
            android:id="@+id/btnClearGlobalSearch"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="✕ Limpiar"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/button_text_selector"
            android:background="@drawable/button_focus_selector"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/rvCategories"
            android:nextFocusDown="@id/rvEvents"
            android:nextFocusLeft="@id/btnVoiceGlobalSearch" />
    </LinearLayout>

    <!-- Main Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/loading_events"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEvents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="false" />
    </FrameLayout>
</LinearLayout>
