<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="28dp"
    android:paddingBottom="28dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:scaleType="fitCenter"
            android:src="@drawable/app_icon"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="20dp"
            android:gravity="start|center_vertical">

            <!-- Fila superior: Hora y meridiano (mayor magnitud) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextClock
                    android:id="@+id/textClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextClock
                    android:id="@+id/textClockAmPm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour=" (a)"
                    android:format24Hour=""
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent" />

                <TextView
                    android:id="@+id/tvTimeZone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Fila inferior: Fecha y Versión Actual -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Contenedor vertical para Botones de Cabecera y Descripción al Enfocar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <!-- Fila de Botones -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/btnUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:focusable="true"
                    android:clickable="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/button_focus_selector">

                    <ImageView
                        android:id="@+id/ivUpdateIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_cloud_download"
                        android:duplicateParentState="true"
                        app:tint="@color/button_text_selector"
                        android:contentDescription="Actualizar APK" />

                    <TextView
                        android:id="@+id/tvUpdateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Actualizado"
                        android:textSize="16sp"
                        android:duplicateParentState="true"
                        android:textColor="@color/button_text_selector"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recargar"
                    android:textSize="16sp"
                    android:textColor="@color/button_text_selector"
                    android:focusable="true"
                    android:clickable="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/button_focus_selector" />
            </LinearLayout>

            <!-- Detalle explicativo contextual que aparece debajo de los botones al recibir el foco -->
            <TextView
                android:id="@+id/tvHeaderButtonHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="2dp"
                android:textSize="11sp"
                android:textColor="@color/accent"
                android:textStyle="bold"
                android:visibility="gone"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <!-- Category / Country Tabs for TV -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:layout_marginBottom="16dp"
        android:focusable="false" />

    <!-- Search and Sort Bar (exclusivo para pestaña Repeticiones) -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/btnVoiceSearchReplay"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/voice_button_selector"
            android:nextFocusUp="@id/rvCategories"
            android:nextFocusDown="@id/rvEvents"
            android:nextFocusRight="@id/etSearch">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_google_mic"
                android:duplicateParentState="true"
                android:contentDescription="Búsqueda por voz" />
        </LinearLayout>

        <!-- Caja de Búsqueda Visual Unificada con X interna (Repeticiones) -->
        <LinearLayout
            android:id="@+id/searchBoxContainerReplay"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/search_box_selector"
            android:addStatesFromChildren="true">

            <com.gareca.tv.SearchEditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Buscar repetición por partido o fecha (ej: Madrid, 10/10)..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:textSize="15sp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:cursorVisible="false"
                android:nextFocusUp="@id/rvCategories"
                android:nextFocusDown="@id/rvEvents"
                android:nextFocusLeft="@id/btnVoiceSearchReplay"
                android:nextFocusRight="@id/btnClearSearchText" />

            <ImageView
                android:id="@+id/btnClearSearchText"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                android:background="@drawable/button_focus_selector"
                android:focusable="true"
                android:clickable="true"
                android:focusableInTouchMode="true"
                android:visibility="gone"
                android:contentDescription="Borrar texto y escribir"
                android:nextFocusUp="@id/rvCategories"
                android:nextFocusDown="@id/rvEvents"
                android:nextFocusLeft="@id/etSearch"
                android:nextFocusRight="@id/btnSearchReplay" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSearchReplay"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/button_focus_selector"
            android:nextFocusUp="@id/rvCategories"
            android:nextFocusDown="@id/rvEvents"
            android:nextFocusLeft="@id/etSearch"
            android:nextFocusRight="@id/btnSortDate">

            <ImageView
                android:id="@+id/ivSearchIconReplay"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search"
                android:duplicateParentState="true"
                app:tint="@color/button_text_selector"
                android:contentDescription="Buscar" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSortDate"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="📅 Fecha (Recientes)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/button_text_selector"
            android:background="@drawable/button_focus_selector"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/rvCategories"
            android:nextFocusDown="@id/rvEvents"
            android:nextFocusLeft="@id/btnSearchReplay"
            android:nextFocusRight="@id/btnSortName" />

        <Button
            android:id="@+id/btnSortName"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="🔤 Nombre (A-Z)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/button_text_selector"
            android:background="@drawable/button_focus_selector"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/rvCategories"
            android:nextFocusDown="@id/rvEvents"
            android:nextFocusLeft="@id/btnSortDate" />
    </LinearLayout>

    <!-- Global Search Bar (para pestaña Buscar Todo) -->
    <LinearLayout
        android:id="@+id/globalSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/btnVoiceGlobalSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/voice_button_selector"
            android:nextFocusUp="@id/rvCategories"
            android:nextFocusDown="@id/rvEvents"
            android:nextFocusRight="@id/etGlobalSearch">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_google_mic"
                android:duplicateParentState="true"
                android:contentDescription="Búsqueda por voz" />
        </LinearLayout>

        <!-- Caja de Búsqueda Visual Unificada con X interna (Buscar Todo) -->
        <LinearLayout
            android:id="@+id/searchBoxContainerGlobal"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/search_box_selector"
            android:addStatesFromChildren="true">

            <com.gareca.tv.SearchEditText
                android:id="@+id/etGlobalSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Buscar equipo o canal en TODO GarecaTV (ej: Madrid, Boca, ESPN)..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:textSize="15sp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:cursorVisible="false"
                android:nextFocusUp="@id/rvCategories"
                android:nextFocusDown="@id/rvEvents"
                android:nextFocusLeft="@id/btnVoiceGlobalSearch"
                android:nextFocusRight="@id/btnClearGlobalText" />

            <ImageView
                android:id="@+id/btnClearGlobalText"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                android:background="@drawable/button_focus_selector"
                android:focusable="true"
                android:clickable="true"
                android:focusableInTouchMode="true"
                android:visibility="gone"
                android:contentDescription="Borrar texto y escribir"
                android:nextFocusUp="@id/rvCategories"
                android:nextFocusDown="@id/rvEvents"
                android:nextFocusLeft="@id/etGlobalSearch"
                android:nextFocusRight="@id/btnSearchGlobal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSearchGlobal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/button_focus_selector"
            android:nextFocusUp="@id/rvCategories"
            android:nextFocusDown="@id/rvEvents"
            android:nextFocusLeft="@id/btnClearGlobalText"
            android:nextFocusRight="@id/btnSortNameGlobal">

            <ImageView
                android:id="@+id/ivSearchIconGlobal"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search"
                android:duplicateParentState="true"
                app:tint="@color/button_text_selector"
                android:contentDescription="Buscar" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSortNameGlobal"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="🔤 Nombre (A-Z)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/button_text_selector"
            android:background="@drawable/button_focus_selector"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@id/rvCategories"
            android:nextFocusDown="@id/rvEvents"
            android:nextFocusLeft="@id/btnSearchGlobal" />
    </LinearLayout>

    <!-- Contenedor de Sugerencias en Pantalla para TV -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="12dp"
        android:descendantFocusability="afterDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Main Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/loading_events"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEvents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="false" />
    </FrameLayout>
</LinearLayout>
