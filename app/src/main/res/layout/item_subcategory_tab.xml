<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="36dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:focusable="true"
    android:clickable="true"
    android:focusableInTouchMode="true"
    android:layout_marginEnd="8dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="@drawable/category_tab_selector">

    <TextView
        android:id="@+id/tvSubcategoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Noticias"
        android:textSize="13sp"
        android:textStyle="bold"
        android:duplicateParentState="true"
        android:textColor="@color/tab_text_selector" />

    <TextView
        android:id="@+id/tvSubcategoryCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_marginStart="6dp"
        android:text="14"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#38BDF8"
        android:background="@drawable/sidebar_count_badge"
        android:duplicateParentState="true" />

</LinearLayout>
