<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:focusable="true"
    android:clickable="true"
    android:focusableInTouchMode="true"
    android:background="@drawable/card_selector"
    android:padding="10dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/ivThumbnail"
        android:layout_width="70dp"
        android:layout_height="44dp"
        android:scaleType="centerCrop"
        android:background="#222634"
        android:visibility="gone"
        android:contentDescription="Thumbnail" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">

        <!-- Fila 1: Título completo del evento / canal sin restricciones de espacio -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Real Madrid vs Villarreal"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Fila 2: Hora + Cuenta regresiva + Subtítulo / País / Categoría -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18:00"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#2000E5FF"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ En 2h 15m"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/accent"
                android:background="#2000E5FF"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transmisión en Vivo"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Fila lateral derecha: Distintivo de Stream Compacto + Botón Favorito + Botón Play -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Insignia distintiva compacta del motor de reproducción -->
        <TextView
            android:id="@+id/tvStreamBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ HLS"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@color/live_red"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginEnd="6dp" />

        <!-- Botón interactivo para añadir/quitar Favorito -->
        <TextView
            android:id="@+id/btnCardFavorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☆ Fav"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:focusable="true"
            android:clickable="true"
            android:focusableInTouchMode="true"
            android:background="@drawable/card_btn_fav_selector"
            android:layout_marginEnd="6dp" />

        <!-- Botón interactivo para reproducir señal -->
        <TextView
            android:id="@+id/btnCardPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶ Ver"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:focusable="true"
            android:clickable="true"
            android:focusableInTouchMode="true"
            android:background="@drawable/card_btn_play_selector" />
    </LinearLayout>

</LinearLayout>
