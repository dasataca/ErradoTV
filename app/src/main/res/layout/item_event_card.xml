<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:focusable="true"
    android:clickable="true"
    android:focusableInTouchMode="true"
    android:background="@drawable/card_selector"
    android:padding="12dp"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/ivThumbnail"
        android:layout_width="80dp"
        android:layout_height="50dp"
        android:scaleType="centerCrop"
        android:background="#222634"
        android:visibility="gone"
        android:contentDescription="Thumbnail" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18:00"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="#2000E5FF"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Real Madrid vs Villarreal"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transmisión en Vivo"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Contenedor Derecho para Canales (Insignia Compacta + Botón Favorito + Botón Play) -->
    <LinearLayout
        android:id="@+id/llChannelActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvChannelStreamBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ HLS"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@color/live_red"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnCardFavorite"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="★"
            android:textSize="18sp"
            android:textColor="#64748B"
            android:focusable="true"
            android:clickable="true"
            android:focusableInTouchMode="true"
            android:background="@drawable/card_btn_fav_selector"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnCardPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶ Ver"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:focusable="true"
            android:clickable="true"
            android:focusableInTouchMode="true"
            android:background="@drawable/card_btn_play_selector" />
    </LinearLayout>

    <!-- Contenedor Derecho para Partidos de Deportes (Anterior Interfaz Limpia: Badge + Countdown) -->
    <LinearLayout
        android:id="@+id/llMatchStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tvStreamBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EN VIVO"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@color/live_red"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ En 2h 15m"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:background="#2000E5FF"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginTop="4dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
