<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E2333"
    android:padding="28dp">

    <TextView
        android:id="@+id/tvUpdateHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¡Nueva Versión Disponible!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/accent" />

    <TextView
        android:id="@+id/tvVersionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GarecaTV"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvGracePeriodWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Días de gracia restantes: 2 días"
        android:textSize="14sp"
        android:textColor="#F59E0B"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tvChangelog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Novedades de la actualización..."
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Más tarde"
            android:textColor="@color/button_text_selector"
            android:background="@drawable/button_focus_selector"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnConfirmUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actualizar Ahora"
            android:textColor="@color/button_text_selector"
            android:background="@drawable/button_focus_selector"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

</LinearLayout>
