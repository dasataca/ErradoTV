<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:show_timeout="3500"
        app:auto_show="false"
        app:resize_mode="fit" />

    <ProgressBar
        android:id="@+id/playerBuffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible" />

    <TextView
        android:id="@+id/playerError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:background="#80000000"
        android:padding="16dp"
        android:visibility="gone" />

    <!-- Banner de información de canal (Zapping y navegación D-Pad en TV) -->
    <LinearLayout
        android:id="@+id/llChannelBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#E60A0D14"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:focusable="false"
        android:clickable="false"
        android:visibility="gone"
        android:elevation="15dp">

        <ImageView
            android:id="@+id/ivChannelLogo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="18dp"
            android:contentDescription="Logo del Canal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChannelBannerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Canal"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvChannelBannerSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvChannelBannerIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp" />

        <Button
            android:id="@+id/btnZoomMode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="18dp"
            android:background="@drawable/button_focus_selector"
            android:text="🔍 Zoom: Ajuste"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Indicador HUD Flotante de Zoom / Relación de Aspecto -->
    <TextView
        android:id="@+id/tvZoomHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#D90B0E14"
        android:textColor="@color/accent"
        android:textStyle="bold"
        android:textSize="17sp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:elevation="20dp" />

    <TextView
        android:id="@+id/tvResolutionBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="32dp"
        android:background="#B3121622"
        android:textColor="@color/accent"
        android:textStyle="bold"
        android:textSize="15sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:elevation="10dp" />

</FrameLayout>
