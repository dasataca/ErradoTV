<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="38dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:focusable="true"
    android:clickable="true"
    android:focusableInTouchMode="true"
    android:layout_marginBottom="4dp"
    android:paddingStart="6dp"
    android:paddingEnd="10dp"
    android:background="@drawable/sidebar_nav_selector">

    <!-- Indicador vertical de acento (cyan) al estar seleccionado/enfocado -->
    <View
        android:id="@+id/viewAccentBar"
        android:layout_width="3dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        android:background="#00E5FF"
        android:visibility="invisible" />

    <!-- Título de la categoría o país -->
    <TextView
        android:id="@+id/tvSidebarCategoryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="📺 Variedades"
        android:textSize="13sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:duplicateParentState="true"
        android:textColor="@color/sidebar_nav_text_selector" />

    <!-- Badge contador de canales (ej. 142) -->
    <TextView
        android:id="@+id/tvSidebarCategoryCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="0"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#38BDF8"
        android:background="@drawable/sidebar_count_badge"
        android:duplicateParentState="true" />

</LinearLayout>
